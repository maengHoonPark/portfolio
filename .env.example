# 프론트 (.env.local 로 복사해서 사용, 커밋 금지)
GITHUB_TOKEN=
GITHUB_USERNAME=
NEXT_PUBLIC_API_URL=http://localhost:8080

# 서버 (server/ 에서 사용, 커밋 금지)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ALLOWED_ORIGINS=http://localhost:3000
# 리버스 프록시(Render 등) 뒤에서만 true
TRUST_FORWARDED_FOR=false
